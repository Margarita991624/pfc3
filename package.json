{
  "name": "mercaorden",
  "version": "1.0.0",
  "private": true,
  "description": "MercaOrden - Formalización del comercio mayorista (caso La Parada). PFC III USIL.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --output-file",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^7.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "~5.9",
    "vitest": "^5.1.1"
  }
}
